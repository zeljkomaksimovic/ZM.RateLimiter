{
  "Redis": {
    "ConnectionString": "redis:6379",
    "Database": 0,
    "KeyPrefix": "rate-limiter"
  },
  "RateLimiting": {
    "DefaultPolicy": null,
    "Policies": {
      "free": {
        "Algorithm": "FixedWindow",
        "Limit": 60,
        "Window": "00:01:00"
      },
      "pro": {
        "Algorithm": "SlidingWindow",
        "Limit": 1000,
        "Window": "00:01:00"
      },
      "internal": {
        "Algorithm": "SlidingWindow",
        "Limit": 10000,
        "Window": "00:01:00"
      }
    },
    "ClientPolicies": {
      "demo-free-client": "free",
      "demo-pro-client": "pro",
      "demo-internal-client": "internal"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
